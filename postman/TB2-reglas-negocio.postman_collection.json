{
  "info": {
    "name": "RestoPilot TB2 — reglas de negocio",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden sobre una base de demostración actualizada. Crea cliente, carta, pedidos, pagos, mesa y reserva de prueba; conserva registros. Configurar restauranteId y administrador. Pedidos requieren horario abierto y delivery habilitado. No incluye pasarela ni IA."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "restauranteId",
      "value": "1"
    },
    {
      "key": "adminCorreo",
      "value": "cristian@restopilot.com"
    },
    {
      "key": "adminPassword",
      "value": "Password123!"
    }
  ],
  "item": [
    {
      "name": "01 Login administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{adminCorreo}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"tokenAdmin\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Registro de cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreCompleto\": \"Cliente sustentación TB2\",\n  \"correo\": \"{{clienteCorreo}}\",\n  \"password\": \"Password123!\",\n  \"rol\": \"CLIENTE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"tokenCliente\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Crear categoría",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/categorias",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenAdmin}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"restauranteId\": \"{{restauranteId}}\",\n  \"nombre\": \"Carta TB2 {{runId}}\",\n  \"descripcion\": \"Prueba de reglas\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"categoriaId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
