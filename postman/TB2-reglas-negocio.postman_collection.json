        "body": {
          "mode": "raw",
          "raw": "{\n  \"restauranteId\": \"{{restauranteId}}\",\n  \"tipoEntrega\": \"DELIVERY\",\n  \"direccionEntrega\": \"Av. Primavera 123\",\n  \"detalles\": [\n    {\n      \"platoId\": \"{{platoId}}\",\n      \"cantidad\": 2,\n      \"notas\": \"Sin ají\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"pedidoId\", pm.response.json().id);",
              "pm.test(\"Total S/40 y precio histórico S/20\", () => {const p=pm.response.json();pm.expect(p.total).to.eql(40);pm.expect(p.detalles[0].precioUnitario).to.eql(20);pm.expect(p.direccionEntrega).to.eql(\"Av. Primavera 123\");});"
            ]
          }
        }
      ]
    },
