          "mode": "raw",
          "raw": "{\n  \"restauranteId\": \"{{restauranteId}}\",\n  \"categoriaId\": \"{{categoriaId}}\",\n  \"nombre\": \"Lomo TB2 {{runId}}\",\n  \"precio\": 20,\n  \"complejidad\": \"MEDIA\",\n  \"tiempoPreparacionMinutos\": 15,\n  \"disponible\": true\n}",
          "options": {
