      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"ALTA/5 precede a MEDIA/15\", () => {const ids=pm.response.json().content.map(p=>String(p.id));const a=ids.indexOf(String(pm.collectionVariables.get(\"pedidoComplejoId\")));const m=ids.indexOf(String(pm.collectionVariables.get(\"pedidoId\")));pm.expect(a).to.be.at.least(0);pm.expect(m).to.be.at.least(0);pm.expect(a).to.be.below(m);});"
            ]
          }
        }
      ]
    },
