  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.info.requestName.startsWith(\"01 \")) {",
          " const id=String(Date.now());pm.collectionVariables.set(\"runId\",id);",
          " for(const [key,prefix] of [[\"ownerCorreo\",\"owner\"],[\"otroOwnerCorreo\",\"owner2\"],[\"adminCorreo\",\"admin\"],[\"clienteCorreo\",\"cliente\"],[\"intentoCorreo\",\"intento\"]])pm.collectionVariables.set(key,prefix+\"-\"+id+\"@example.com\");",
          " for(const key of [\"ownerToken\",\"adminToken\",\"clienteToken\",\"restauranteId\",\"otroRestauranteId\"])pm.collectionVariables.unset(key);",
          "}"
        ]
      }
    }
  ]
