{
  "info": {
    "name": "RestoPilot US21 y US22 — alta de dueño y administradores",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden. Crea dos restaurantes con sus dueños, un administrador y un cliente. No necesita usuarios de demostración previos. US18 sigue siendo pagos administrativos. Configurar baseUrl para una base de demostración."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    }
  ],
  "item": [
    {
      "name": "01 US21 Registro dueño y restaurante",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/register-owner",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreCompleto\": \"Dueño TB2\",\n  \"correo\": \"{{ownerCorreo}}\",\n  \"password\": \"Password123!\",\n  \"restaurante\": {\n    \"nombre\": \"Restaurante TB2 {{runId}}\",\n    \"direccion\": \"Av. Lima 123\",\n    \"telefono\": \"987654321\",\n    \"horaApertura\": \"09:00\",\n    \"horaCierre\": \"22:00\",\n    \"tieneAtencionFisica\": true,\n    \"aceptaDelivery\": true\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const r=pm.response.json();pm.collectionVariables.set(\"ownerToken\",r.token);pm.collectionVariables.set(\"restauranteId\",r.restauranteId); }",
              "pm.test(\"Rol DUENO y restaurante asignado\", () => { const r=pm.response.json();pm.expect(r.rol).to.eql(\"DUENO\");pm.expect(r.restauranteId).to.be.a(\"number\"); });"
            ]
          }
        }
      ]
    },
