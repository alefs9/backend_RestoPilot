    {
      "name": "06 US22 Dueño incorpora administrador",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/usuarios/administradores",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ownerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreCompleto\": \"Administrador TB2\",\n  \"correo\": \"{{adminCorreo}}\",\n  \"password\": \"Password123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Rol y restaurante del dueño\", () => {const r=pm.response.json();pm.expect(r.rol).to.eql(\"ADMINISTRADOR\");pm.expect(String(r.restauranteId)).to.eql(String(pm.collectionVariables.get(\"restauranteId\")));pm.expect(r).not.to.have.property(\"token\");pm.expect(r).not.to.have.property(\"password\");pm.expect(r).not.to.have.property(\"passwordHash\");});"
            ]
          }
        }
      ]
