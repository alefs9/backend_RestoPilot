# Copiar los valores a .env (ignorado por Git). No usar este ejemplo como credencial.
SPRING_PROFILES_ACTIVE=supabase
PORT=8081
# Copiar host y usuario exactos de Connect > Session pooler > JDBC (puerto 5432).
# Guardar la password aparte evita problemas de codificacion en la URL.
DB_URL=jdbc:postgresql://HOST_SESSION_POOLER:5432/postgres?sslmode=require&currentSchema=restopilot
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=REEMPLAZAR_LOCALMENTE
# Secreto propio del backend: Base64 de al menos 32 bytes aleatorios.
# Conservar el secreto existente si ya es valido. No es una API key de Supabase.
JWT_SECRET=REEMPLAZAR_LOCALMENTE
JWT_EXPIRATION=86400000
DEMO_ENABLED=false
